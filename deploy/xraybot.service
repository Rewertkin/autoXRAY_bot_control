[Unit]
Description=Telegram bot for autoXRAY bridge clients
After=network-online.target xray.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/xraybot
Environment=XRAYBOT_ENV=/opt/xraybot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/xraybot/venv/bin/python -m xraybot run
Restart=always
RestartSec=10

# Бот правит конфиг Xray и перезапускает его, поэтому работает от root,
# но видит на запись только нужные каталоги.
ProtectSystem=strict
ReadWritePaths=/usr/local/etc/xray /var/lib/xraybot
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
