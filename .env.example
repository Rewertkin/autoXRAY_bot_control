# Скопируй в /opt/xraybot/.env и заполни. Права на файл: chmod 600.

# Токен бота от @BotFather
BOT_TOKEN=

# Твой Telegram ID (узнать: @userinfobot). Несколько через запятую.
ADMIN_IDS=

# Домен моста (RU сервер), на который указывают ссылки клиентов
DOMAIN=link.example.com

# Прокси для связи бота с Telegram:
#   auto - через собственный SOCKS-вход бота (127.0.0.1:BOT_SOCKS_PORT), направленный прямо в NL (рекомендуется)
#   none - напрямую
#   socks5://user:pass@127.0.0.1:1080 - свой прокси
TG_PROXY=auto

# Часовой пояс для дат в боте
TZ_NAME=Europe/Moscow

# ---- Обычно менять не нужно ----
# XRAY_CONFIG=/usr/local/etc/xray/config.json
# XRAY_BIN=/usr/local/bin/xray
# XRAY_API=127.0.0.1:10085
# DB_PATH=/var/lib/xraybot/bot.db
# CERT_PATH=/var/lib/xray/cert/fullchain.pem
# WEB_ROOT=/var/www/link.example.com

# Теги inbound'ов моста autoXRAY
# XHTTP_TAG=RUbrEUxhttpTLS
# VISION_TAG=RUbrEUtlsVISION
# SOCKS_TAG=RUsocks5
# Порт SOCKS-входа бота (создаётся командой patch, слушает только 127.0.0.1)
# BOT_SOCKS_PORT=10444

# Номер маршрута до NL в UUID ссылок (vlessRoute). 1 = первый NL сервер в мосту.
# ROUTE_ID=1

# Шаблоны ссылок. Если пусто, бот сам найдёт ссылки на странице подписки моста.
# Можно вставить любую рабочую ссылку моста целиком, бот подставит в неё UUID и имя клиента.
# LINK_TEMPLATE_XHTTP=
# LINK_TEMPLATE_VISION=

# Интервалы опроса Xray, секунды
# TRAFFIC_POLL_SEC=60
# ONLINE_POLL_SEC=30
# Сколько секунд после последней активности клиент считается онлайн
# ONLINE_WINDOW_SEC=120
# Интервал автодиагностики, минуты (включается кнопкой в боте)
# AUTODIAG_MIN=15
# Как часто проверять связь RU -> NL для показателя «Без разрывов», секунды
# CHAIN_PROBE_SEC=60
